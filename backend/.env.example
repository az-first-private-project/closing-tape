# ============================================================
# GFNA V5 环境变量模板
#   复制为 backend/.env 后修改；根目录 .env 用于 docker compose
# ============================================================

# ---------------- PostgreSQL ----------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE=gfna_db
# 连接池（并发重时调大）
DB_POOL_SIZE=10
DB_ECHO=0

# ---------------- DeepSeek（AI 摘要与日报）----------------
# 留空则：新闻不生成摘要、日报自动降级为"数据摘要"（功能不受影响）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3

# ---------------- 数据源与合规限频 ----------------
# 主源：akshare；兜底：baostock（本机若东财被墙，可把主源设为 baostock）
DATA_PRIMARY_PROVIDER=akshare
DATA_FALLBACK_PROVIDER=baostock
# 全市场快照 ≤ 1 次/分钟；历史回补 ≤ 2 请求/秒
SNAPSHOT_MIN_INTERVAL_SEC=60
HISTORY_REQUESTS_PER_SEC=2
FETCH_TIMEOUT_SEC=30
FETCH_MAX_RETRIES=3
# 置 0 则完全不联网（CI / 离线演示），全链路走 fixture
INGEST_NETWORK_ENABLED=1
# 固定 UA（合规要求：不实现反爬绕过）
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 GFNA/5.0 (personal research)

# ---------------- 历史与交易日 ----------------
HISTORY_START=2021-01-01
SNAPSHOT_READY_HOUR=15
SNAPSHOT_READY_MINUTE=30

# ---------------- 数据质量阈值 ----------------
QUALITY_MIN_UNIVERSE=4000
QUALITY_MIN_SNAPSHOT_ROWS=3500
QUALITY_MIN_COVERAGE=0.95
QUALITY_MAX_ABS_PCT_CHG=30
QUALITY_PRICE_JUMP_RATIO=0.5

# ---------------- 评分权重 ----------------
WEIGHT_TECHNICAL=0.40
WEIGHT_SENTIMENT=0.35
WEIGHT_NEWS=0.25
SENT_WEIGHT_MARGIN=0.25
SENT_WEIGHT_NORTH=0.25
SENT_WEIGHT_NEWS=0.25
SENT_WEIGHT_FLOW=0.25

# ---------------- 回测默认参数 ----------------
BT_REBALANCE_DAYS=20
BT_MAX_POSITIONS=20
BT_BENCHMARK=sh000300
BT_COMMISSION=0.00025
BT_STAMP_TAX=0.001
BT_SLIPPAGE=0.001
BT_MIN_COMMISSION=5
BT_INITIAL_CASH=1000000
BT_EXCLUDE_NEW_DAYS=60

# ---------------- 服务 ----------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
# 1=JSON 结构化日志（含 request_id / task / run_id）
LOG_JSON=0
# 定时任务开关（测试/CI 置 0）
SCHEDULER_ENABLED=1
# 启动时兜底建表（生产建议 0，用 bootstrap_db.py / alembic）
AUTO_CREATE_TABLES=1
# 管理接口密钥（留空=仅允许本机访问 /api/v1/admin/*）
ADMIN_API_KEY=
# 允许的 CORS 来源，逗号分隔；* 表示放开
CORS_ORIGINS=*

# ---------------- 新闻链路（可选）----------------
CRAWL_INTERVAL_MINUTES=60
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=2.0

# ---------------- 演示模式 ----------------
# ENV=demo 时才允许 POST /api/v1/admin/seed-demo
ENV=production

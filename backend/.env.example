# ============================================================
# GFNA (全球财经新闻聚合器) 环境变量配置
# ============================================================
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 修改 .env 中的实际值
#   3. 注意: .env 文件已在 .gitignore 中，不会被提交到 Git
# ============================================================

# ==================== PostgreSQL 数据库配置 ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE=gfna_db

# Docker 部署时:
# POSTGRES_HOST=postgres
# POSTGRES_PASSWORD=gfna_secret

# ==================== DeepSeek API 配置 ====================
# 【重要】本项目的 AI 摘要使用 DeepSeek API
# 获取 Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== LLM 参数配置 ====================
# 摘要最大 token 数 (控制输出长度)
LLM_MAX_TOKENS=300
# 生成温度 (0=确定性, 1=随机性, 新闻建议 0.3)
LLM_TEMPERATURE=0.3
# API 调用失败最大重试次数
LLM_MAX_RETRIES=3

# ==================== 爬虫配置 ====================
# 定时爬取间隔 (分钟)
CRAWL_INTERVAL_MINUTES=60
# 并发请求数
CONCURRENT_REQUESTS=8
# 下载延迟 (秒)
DOWNLOAD_DELAY=2.0

# ==================== 服务器配置 ====================
# FastAPI 服务端口
SERVER_PORT=8000
# 服务绑定地址 (0.0.0.0 = 监听所有网络接口)
SERVER_HOST=0.0.0.0
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ==================== 安全配置 ====================
# 管理 API Key (用于手动触发爬虫等管理操作)
# 修改为随机字符串以提高安全性
ADMIN_API_KEY=gfna-admin-key-change-me

# API 限流 (格式: "次数/时间", 如 "60/minute")
API_RATE_LIMIT=60/minute